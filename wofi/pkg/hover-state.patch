diff -ruN a/src/wofi.c b/src/wofi.c
--- a/src/wofi.c
+++ b/src/wofi.c
@@ -1067,6 +1067,40 @@
 	previous_selection = box;
 }
 
+// GtkFlowBox never sets the prelight state on its children, so track the
+// child under the pointer ourselves to make #entry:hover work in CSS.
+static GtkWidget* hover_child = NULL;
+
+static void set_hover(GtkWidget* child) {
+	if(child == hover_child) {
+		return;
+	}
+	if(hover_child != NULL) {
+		gtk_widget_unset_state_flags(hover_child, GTK_STATE_FLAG_PRELIGHT);
+		g_object_remove_weak_pointer(G_OBJECT(hover_child), (gpointer*) &hover_child);
+	}
+	hover_child = child;
+	if(hover_child != NULL) {
+		g_object_add_weak_pointer(G_OBJECT(hover_child), (gpointer*) &hover_child);
+		gtk_widget_set_state_flags(hover_child, GTK_STATE_FLAG_PRELIGHT, FALSE);
+	}
+}
+
+static gboolean do_hover(GtkWidget* flow_box, GdkEventMotion* event, gpointer data) {
+	(void) data;
+	GtkFlowBoxChild* child = gtk_flow_box_get_child_at_pos(GTK_FLOW_BOX(flow_box), event->x, event->y);
+	set_hover(child == NULL ? NULL : GTK_WIDGET(child));
+	return FALSE;
+}
+
+static gboolean clear_hover(GtkWidget* flow_box, GdkEventCrossing* event, gpointer data) {
+	(void) flow_box;
+	(void) event;
+	(void) data;
+	set_hover(NULL);
+	return FALSE;
+}
+
 static void activate_search(GtkEntry* entry, gpointer data) {
 	(void) data;
 	GtkFlowBoxChild* child = gtk_flow_box_get_child_at_index(GTK_FLOW_BOX(inner_box), 0);
@@ -2113,6 +2147,8 @@
 
 	g_signal_connect(inner_box, "child-activated", G_CALLBACK(activate_item), NULL);
 	g_signal_connect(inner_box, "selected-children-changed", G_CALLBACK(select_item), NULL);
+	g_signal_connect(inner_box, "motion-notify-event", G_CALLBACK(do_hover), NULL);
+	g_signal_connect(inner_box, "leave-notify-event", G_CALLBACK(clear_hover), NULL);
 	g_signal_connect(entry, "activate", G_CALLBACK(activate_search), NULL);
 	g_signal_connect(window, "key-press-event", G_CALLBACK(key_press), NULL);
 	g_signal_connect(window, "focus-in-event", G_CALLBACK(focus), NULL);
